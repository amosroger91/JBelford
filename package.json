{
  "name": "jbelford",
  "version": "0.5.1",
  "description": "Intraday BTC/USD spot research, backtesting and paper-trading system (paper by default).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:exchange": "node --disable-warning=ExperimentalWarning --import tsx src/cli/validateExchange.ts",
    "history:fetch": "node --disable-warning=ExperimentalWarning --import tsx src/cli/fetchHistory.ts",
    "backtest": "node --disable-warning=ExperimentalWarning --import tsx src/cli/backtest.ts",
    "optimize": "node --disable-warning=ExperimentalWarning --import tsx src/cli/optimize.ts",
    "paper": "node --disable-warning=ExperimentalWarning dist/cli.js paper",
    "dashboard": "node --disable-warning=ExperimentalWarning --import tsx src/cli/dashboard.ts",
    "kill": "node --disable-warning=ExperimentalWarning --import tsx src/cli/kill.ts",
    "halt:status": "node --disable-warning=ExperimentalWarning --import tsx src/cli/halt.ts status",
    "halt:reset": "node --disable-warning=ExperimentalWarning --import tsx src/cli/halt.ts reset",
    "report": "node --disable-warning=ExperimentalWarning --import tsx src/cli/report.ts",
    "proposal": "node --disable-warning=ExperimentalWarning --import tsx src/cli/proposal.ts",
    "live:authorize": "node --disable-warning=ExperimentalWarning --import tsx src/cli/liveAuthorize.ts",
    "live": "node --disable-warning=ExperimentalWarning --import tsx src/cli/live.ts",
    "gate": "node --disable-warning=ExperimentalWarning --import tsx src/cli/gate.ts",
    "context": "node --disable-warning=ExperimentalWarning --import tsx src/cli/context.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build": "tsc --noEmit && esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/cli.js",
    "test:acceptance": "vitest run test/paper/acceptance --reporter=default --reporter=json --outputFile.json=artifacts/acceptance/latest.json",
    "test:e2e": "playwright test",
    "paper:cli": "node --disable-warning=ExperimentalWarning --import tsx src/cli/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amosroger91/JBelford.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/amosroger91/JBelford/issues"
  },
  "homepage": "https://github.com/amosroger91/JBelford#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ccxt": "^4.5.91",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
